# Select yahoo for delayed snapshot/polling or finnhub for WebSocket streaming.
SYNTHIA_FINANCE_PROVIDER=yahoo
SYNTHIA_FINANCE_API_KEY=
SYNTHIA_FINANCE_SYMBOLS=AAPL,MSFT,SPY
SYNTHIA_FINANCE_MODE=snapshot
# Optional WebSocket override; the Finnhub secure endpoint is the default.
SYNTHIA_FINANCE_ENDPOINT=wss://ws.finnhub.io